<%- include('partials/header') %>

<div class="container not-found-container">
  <div class="not-found-card">
    <div class="not-found-icon">
      <i class="fa-solid fa-link-slash"></i>
    </div>
    <span class="error-code">404</span>
    <h1 class="not-found-title">Link Not Found</h1>
    <p class="not-found-desc">
      The shortened URL or page you are looking for does not exist, has expired, or may have been deleted.
    </p>

    <div class="not-found-actions">
      <a href="/" class="btn btn-primary">
        <i class="fa-solid fa-house"></i> Return to Homepage
      </a>
      <a href="/#recent-section" class="btn btn-secondary">
        <i class="fa-solid fa-clock-rotate-left"></i> View Recent Links
      </a>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
